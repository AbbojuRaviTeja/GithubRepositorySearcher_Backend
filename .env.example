# Copy to .env (already created and gitignored). Never commit a real .env, password, or GitHub token.
# The app loads .env automatically from the project root.

# --- Neon Postgres ---
# Dashboard → your project → Connect. Use the host, database, role, and password.
# Do not put a Neon API key here. The app connects with the database password over SSL.
DB_HOST=YOUR_NEON_HOST
DB_PORT=5432
DB_NAME=neondb
DB_USERNAME=neondb_owner
DB_PASSWORD=
DB_SSL_MODE=require

# --- Local Docker Postgres instead of Neon ---
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=github_searcher
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# DB_SSL_MODE=disable

# Optional GitHub personal access token (fine-grained or classic public_repo / no scope for public search).
# Leave blank to call the API anonymously (about 60 requests/hour). A token raises the limit (about 5,000/hour).
# The token is sent only as "Authorization: Bearer <token>" and is never logged or returned in API errors.
GITHUB_TOKEN=

# Optional GitHub client overrides.
# GITHUB_API_BASE_URL=https://api.github.com
# GITHUB_CONNECT_TIMEOUT=5s
# GITHUB_READ_TIMEOUT=10s
# GITHUB_PER_PAGE=30
# GITHUB_MAX_PAGES=1
# GITHUB_FETCH_ALL_PAGES=false
